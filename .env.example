# Copy values to your shell, a local .env file, or files under .secrets/.
# Never commit real values.

# Polite contact identifiers used by publication metadata services.
CROSSREF_MAILTO=research@example.edu
UNPAYWALL_EMAIL=research@example.edu

# Optional OpenAlex API key. The pipeline also supports
# --openalex-api-key-file .secrets/openalex_api_key.
OPENALEX_API_KEY=

# Optional attribution-feedback export settings.
FEEDBACK_EXPORT_URL=https://your-atlas.example.edu/api/feedback?export=attribution
FEEDBACK_ADMIN_KEY=

# Optional abstract-matching service used by the web application.
SPECTER2_ENDPOINT_URL=http://127.0.0.1:8788/match
SPECTER2_API_TOKEN=
